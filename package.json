{
  "name": "@kyaw-min-khant/rnc",
  "version": "1.0.1",
  "description": "React Native UI library with StyleSheet and NativeWind support",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib"
  ],
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react": "18.2.0",
    "react-native": "0.76.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.0.0"
  },
  "codegenConfig": {
    "name": "RNCSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "author": "Kyaw Min Khant <kyawminkhant8237@gmail.com> (https://github.com/Kyaw-Min-Khant)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Kyaw-Min-Khant",
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "example": "cd example && npm start",
    "example:android": "cd example && npx expo start --android",
    "example:ios": "cd example && npx expo start --ios"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it"
    ],
    "version": "0.57.0"
  }
}
