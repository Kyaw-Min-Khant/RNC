{
  "name": "rnc-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:offline": "EXPO_OFFLINE=1 expo start",
    "android": "expo run:android",
    "android:offline": "EXPO_OFFLINE=1 expo start --android",
    "ios": "expo run:ios",
    "ios:offline": "EXPO_OFFLINE=1 expo start --ios",
    "web:build": "expo export -p web && touch dist/.nojekyll",
    "predeploy": "npm run web:build",
    "deploy": "gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.0",
    "expo-font": "~13.0.4",
    "expo-status-bar": "~2.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.76.0",
    "react-native-web": "^0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.3.3"
  }
}
